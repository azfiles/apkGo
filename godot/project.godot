; Open this directory in Godot 4.6.3.
config_version=5

[application]
config/name="循光 · 流动数字"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.svg"
config/version="2.0.0"

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
; Tiny 2D shaders compile quickly; avoid driver-specific program binaries on restart.
shader_compiler/shader_cache/enabled=false
environment/defaults/default_clear_color=Color(0.035, 0.075, 0.09, 1)

[input_devices]
pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[physics]
common/physics_ticks_per_second=60
2d/default_gravity=0.0

[audio]
driver/enable_input=false
